# Configuración de Google Gemini (Requerido)
# Obtén tu key en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=models/gemini-2.5-flash

# Base de Datos
DATABASE_PATH=data/botbi_pulse.db

# Configuración del Servidor
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# APIs de Mercados (Opcional - El sistema usa CoinGecko público por defecto)
ALPHA_VANTAGE_KEY=

# Configuración de Email (Para Newsletter)
# Si usas Gmail, requieres una "App Password"
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password